# ---------------------------------------------------------------------------
# Aura BaaS Resilience Simulator — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Everything except SESSION_SIGNING_SECRET is optional: without AI or Supabase
# the app still runs (rule-based fallback + in-memory persistence).
# ---------------------------------------------------------------------------

# --- Session signing (server-only, REQUIRED in production) -----------------
# HMAC secret for signed session tokens and workflow entries. >= 16 chars.
# Generate: openssl rand -base64 32
SESSION_SIGNING_SECRET=

# --- AI provider (server-only) ---------------------------------------------
# groq | openai_compatible | ollama | none
AI_PROVIDER=groq
AI_API_KEY=
# Pick a model currently listed by your provider that supports JSON output.
# No model id is hard-coded; check the provider's model list before deploying.
AI_MODEL=
# Only for AI_PROVIDER=openai_compatible (e.g. https://openrouter.ai/api/v1)
# or ollama (default http://localhost:11434/v1 — local development only).
AI_BASE_URL=
# Total time budget for an LLM investigation (ms); initial design target, not a guarantee.
AI_TIMEOUT_MS=8000
AI_MAX_RETRIES=2
AI_MAX_CONCURRENCY=2
# Optional: blended USD price per million tokens, enables AI cost / net value.
AI_PRICE_PER_MILLION_TOKENS_USD=
# Allow AI_PROVIDER=ollama when NODE_ENV=production (not recommended).
ALLOW_LOCAL_AI=false

# --- Supabase (optional) ----------------------------------------------------
# The browser never talks to Supabase; only the server writes with the
# service-role key. Without these, an in-memory store is used.
NEXT_PUBLIC_SUPABASE_URL=
# Not used by the app (no browser DB access); listed for completeness.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DEMO_MODE=true
